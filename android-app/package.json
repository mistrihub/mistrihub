{
  "name": "mistrihub-android",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "build:android": "eas build --platform android --profile production --clear-cache",
    "build:preview": "eas build --platform android --profile preview --clear-cache"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "latest",
    "expo-file-system": "~56.0.7",
    "expo-image-picker": "~56.0.13",
    "expo-video": "~56.1.2",
    "react": "19.2.3",
    "react-native": "latest",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "latest",
    "typescript": "latest"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av",
          "expo-modules-jsi"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
